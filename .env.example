# GlowRank environment — COPY to .env.local and fill. NEVER commit real values. (CLAUDE.md §10)
# All production secrets live in Vercel environment variables, not in committed files.

# --- AI providers ---
ANTHROPIC_API_KEY=          # primary (CLAUDE.md §4/§5)
OPENAI_API_KEY=             # fallback only

# --- Payments (Stripe Checkout, hosted) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=            # optional: pre-created $9.99 Price ID; if unset, api/checkout falls back to inline price_data
CHECKOUT_SUCCESS_URL=       # optional: post-payment redirect; defaults to https://<host>/processing?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=        # optional: abandoned-checkout redirect; defaults to https://<host>/?checkout=cancelled

# --- Photo storage (R2 or S3, 30-day TTL) ---
PHOTO_BUCKET=
PHOTO_STORAGE_ENDPOINT=
PHOTO_STORAGE_ACCESS_KEY_ID=
PHOTO_STORAGE_SECRET_ACCESS_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=                 # e.g. GlowRank <noreply@glowrank.co>

# --- PDF (PDFShift) ---
PDFSHIFT_API_KEY=

# --- Analytics (PostHog) ---
POSTHOG_API_KEY=
POSTHOG_HOST=               # defaults to https://app.posthog.com

# --- Internal ---
CRON_SECRET=                # protects /api/cron/* from public invocation
GENERATE_SECRET=            # shared secret for the internal /api/generate trigger — generate with: openssl rand -hex 32
FLAGGED_EMAIL_SECRET=       # HMAC secret for BDD re-purchase prevention (FOLLOWUPS 3e) — generate with: openssl rand -hex 32
